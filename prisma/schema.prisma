generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  LEARNER
  CREATOR
  MENTOR
  PROFESSIONAL
  EMPLOYER
  ADMIN
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  passwordHash          String?
  username              String?                @unique
  name                  String?
  bio                   String?
  headline              String?
  location              String?
  avatarUrl              String?
  onboardingCompleted   Boolean                @default(false)
  roles                 UserRoleLink[]
  profile               Profile?
  skills                UserSkill[]
  interests             UserInterest[]
  createdCourses        Course[]               @relation("CreatedCourses")
  enrollments           Enrollment[]
  createdProjects       Project[]              @relation("CreatedProjects")
  projectEntitlements   ProjectEntitlement[]
  projectFavorites      ProjectFavorite[]
  projectPhaseProgress  ProjectPhaseProgress[]
  projectRequests       ProjectRequest[]
  purchases             Purchase[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model UserRoleLink {
  id        String   @id @default(cuid())
  role      UserRole
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, role])
  @@index([role])
}

model Institution {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  country   String?
  profiles  Profile[]
  programs  Program[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Program {
  id            String       @id @default(cuid())
  name          String
  slug          String
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  profiles      Profile[]

  @@unique([institutionId, slug])
}

model Profile {
  id            String       @id @default(cuid())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  programId     String?
  program       Program?     @relation(fields: [programId], references: [id], onDelete: SetNull)
  level         String?
  goal          String?
  availability  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Skill {
  id        String      @id @default(cuid())
  name      String      @unique
  slug      String      @unique
  users     UserSkill[]
  createdAt DateTime    @default(now())
}

model UserSkill {
  id        String   @id @default(cuid())
  userId    String
  skillId   String
  level     Int      @default(1)
  verified  Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, skillId])
  @@index([skillId])
}

model Interest {
  id        String         @id @default(cuid())
  name      String         @unique
  slug      String         @unique
  users     UserInterest[]
  createdAt DateTime       @default(now())
}

model UserInterest {
  id         String   @id @default(cuid())
  userId     String
  interestId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, interestId])
  @@index([interestId])
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseAccess {
  FREE
  PAID
}

enum LessonBlockType {
  TEXT
  IMAGE
  VIDEO
  CODE
  QUIZ
  CIRCUIT
  SIMULATION
  TASK
  CHECKPOINT
  UPLOAD
  AI_INTERACTION
}

model CourseCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  courses     Course[]
  createdAt   DateTime @default(now())
}

model Course {
  id           String          @id @default(cuid())
  title        String
  slug         String          @unique
  description  String?
  thumbnailUrl String?
  status       CourseStatus    @default(DRAFT)
  access       CourseAccess    @default(FREE)
  price        Int?
  currency     String          @default("GHS")
  level        String?
  creatorId    String
  creator      User            @relation("CreatedCourses", fields: [creatorId], references: [id], onDelete: Cascade)
  categoryId   String?
  category     CourseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  modules      CourseModule[]
  enrollments  Enrollment[]
  publishedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([creatorId, status])
  @@index([categoryId, status])
}

model CourseModule {
  id        String   @id @default(cuid())
  title     String
  position  Int
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, position])
}

model Lesson {
  id          String           @id @default(cuid())
  title       String
  slug        String
  summary     String?
  position    Int
  durationMin Int?
  isPreview   Boolean          @default(false)
  moduleId    String
  module      CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  blocks      LessonBlock[]
  progress    LessonProgress[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([moduleId, position])
  @@unique([moduleId, slug])
}

model LessonBlock {
  id        String          @id @default(cuid())
  type      LessonBlockType
  position  Int
  data      Json
  lessonId  String
  lesson    Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([lessonId, position])
}

model Enrollment {
  id          String           @id @default(cuid())
  userId      String
  courseId    String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  progress    LessonProgress[]

  @@unique([userId, courseId])
  @@index([courseId])
}

model LessonProgress {
  id           String     @id @default(cuid())
  enrollmentId String
  lessonId     String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed    Boolean    @default(false)
  completedAt  DateTime?
  updatedAt    DateTime   @updatedAt

  @@unique([enrollmentId, lessonId])
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProjectAccess {
  FREE
  PAID
}

enum ProjectDifficulty {
  SIMPLE
  INTERMEDIATE
  ADVANCED
}

enum ProjectMode {
  DIY
  GUIDED
  KIT_READY
}

enum ProjectAcquisition {
  OWNER
  FREE
  PURCHASE
}

enum ProjectRequestStatus {
  SUBMITTED
  REVIEWING
  APPROVED
  DECLINED
  FULFILLED
}

enum PurchaseTarget {
  PROJECT
  COURSE
}

model Project {
  id           String               @id @default(cuid())
  title        String
  slug         String               @unique
  summary      String
  description  String?
  field        String
  area         String?
  difficulty   ProjectDifficulty    @default(INTERMEDIATE)
  modes        ProjectMode[]        @default([])
  status       ProjectStatus        @default(DRAFT)
  access       ProjectAccess        @default(FREE)
  price        Int?
  currency     String               @default("GHS")
  kitPrice     Int?
  creatorId    String
  creator      User                 @relation("CreatedProjects", fields: [creatorId], references: [id], onDelete: Cascade)
  phases       ProjectPhase[]
  components   ProjectComponent[]
  entitlements ProjectEntitlement[]
  favorites    ProjectFavorite[]
  publishedAt  DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([status, field])
  @@index([creatorId, status])
  @@index([access, status])
}

model ProjectPhase {
  id          String                 @id @default(cuid())
  projectId   String
  project     Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String
  position    Int
  progress    ProjectPhaseProgress[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([projectId, position])
}

model ProjectComponent {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  quantity       Int      @default(1)
  unit           String?
  estimatedPrice Int?
  note           String?
  position       Int
  createdAt      DateTime @default(now())

  @@unique([projectId, position])
}

model ProjectEntitlement {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  acquisition ProjectAcquisition
  amountPaid  Int?
  currency    String             @default("GHS")
  acquiredAt  DateTime           @default(now())

  @@unique([userId, projectId])
  @@index([projectId])
}

model ProjectFavorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, projectId])
  @@index([projectId])
}

model ProjectPhaseProgress {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  phaseId     String
  phase       ProjectPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  completed   Boolean      @default(false)
  completedAt DateTime?
  updatedAt   DateTime     @updatedAt

  @@unique([userId, phaseId])
  @@index([phaseId])
}

model ProjectRequest {
  id          String               @id @default(cuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  field       String
  area        String?
  difficulty  ProjectDifficulty    @default(INTERMEDIATE)
  description String
  support     String?
  budget      Int?
  currency    String               @default("GHS")
  status      ProjectRequestStatus @default(SUBMITTED)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
}

model Purchase {
  id          String         @id @default(cuid())
  reference   String         @unique
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType  PurchaseTarget
  targetId    String
  title       String
  amount      Int
  currency    String         @default("GHS")
  paidAt      DateTime       @default(now())
  createdAt   DateTime       @default(now())

  @@index([userId, paidAt])
  @@index([targetType, targetId])
  @@index([paidAt])
}
