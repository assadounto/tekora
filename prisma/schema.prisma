generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  LEARNER
  CREATOR
  MENTOR
  PROFESSIONAL
  EMPLOYER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String?  @unique
  name      String?
  role      UserRole @default(LEARNER)
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
